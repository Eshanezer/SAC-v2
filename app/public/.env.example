# =====================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env or .env.local and fill in your values
# =====================================================================

WP_ENVIRONMENT_TYPE=local

# Database Settings
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD="your_db_password"
DB_HOST=localhost
DB_CHARSET=utf8
DB_COLLATE=
DB_TABLE_PREFIX=wp_

# Debugging Settings
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false
DISALLOW_FILE_EDIT=true

# Multisite Settings
WP_ALLOW_MULTISITE=true
MULTISITE=true
SUBDOMAIN_INSTALL=true
DOMAIN_CURRENT_SITE=spiritassemblychurch.com
PATH_CURRENT_SITE=/
SITE_ID_CURRENT_SITE=1
BLOG_ID_CURRENT_SITE=1

# SMTP Settings
SMTP_HOST=www807.your-server.de
SMTP_PORT=465
SMTP_USER=info@spiritassemblychurch.com
SMTP_PASS="your_smtp_password"
SMTP_SECURE=ssl
SMTP_AUTH=true

# Authentication Keys and Salts (generate new ones at https://api.wordpress.org/secret-key/1.1/salt/)
AUTH_KEY="your-unique-phrase"
SECURE_AUTH_KEY="your-unique-phrase"
LOGGED_IN_KEY="your-unique-phrase"
NONCE_KEY="your-unique-phrase"
AUTH_SALT="your-unique-phrase"
SECURE_AUTH_SALT="your-unique-phrase"
LOGGED_IN_SALT="your-unique-phrase"
NONCE_SALT="your-unique-phrase"
WP_CACHE_KEY_SALT="your-unique-phrase"
